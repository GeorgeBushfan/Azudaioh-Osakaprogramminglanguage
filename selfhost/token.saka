// Canonical token records consumed by the Osaka parser.

func token_make(kind, lexeme, value, start_offset, start_line, start_column, end_offset, end_line, end_column) {
    return {
        "kind": kind,
        "lexeme": lexeme,
        "value": value,
        "span": sh_span(start_offset, start_line, start_column, end_offset, end_line, end_column)
    };
}

func token_eof(offset, line, column) {
    return token_make("EOF", "", 0, offset, line, column, offset, line, column);
}

func token_kind(token) {
    return token["kind"];
}

func token_value(token) {
    return token["value"];
}

func token_span(token) {
    return token["span"];
}

func token_start_line(token) {
    return token["span"]["start"]["line"];
}

func token_is(token, kind) {
    return token["kind"] == kind;
}