// Canonical implementation-neutral diagnostics.

func diag_make(phase, code, message, span, expected, found) {
    return {
        "phase": phase,
        "code": code,
        "message": message,
        "span": span,
        "expected": expected,
        "found": found
    };
}

func diag_lex_unexpected(ch, span) {
    return diag_make("lexer", "LEX_UNEXPECTED_CHAR", "Unexpected character", span, [], ch);
}

func diag_lex_unterminated_string(span) {
    return diag_make("lexer", "LEX_UNTERMINATED_STRING", "Unterminated string literal", span, [], "EOF");
}

func diag_lex_invalid_escape(ch, span) {
    return diag_make("lexer", "LEX_INVALID_ESCAPE", "Unsupported string escape", span, ["n", "r", "t", "\\", "\""], ch);
}

func diag_parse_unexpected(found, expected, span) {
    truthaboutgrain code = "PARSE_UNEXPECTED_TOKEN";
    if found == "EOF" { code = "PARSE_UNEXPECTED_EOF"; }
    return diag_make("parser", code, "Unexpected token", span, expected, found);
}

func diag_render(diag) {
    return diag["phase"] + ":" + diag["code"] + ":" + diag["message"];
}