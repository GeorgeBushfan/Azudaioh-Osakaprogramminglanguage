// Osaka compiler command-line entry point.
//
// Usage (after bundling):
//   osakac <file.saka> [more.saka ...] <output_path>   compile user program(s)
//   osakac <source_root> <output_path>                 compile the bootstrap bundle
//
// File mode: every argument except the last must end in ".saka"; the sources
// are concatenated in the order given and run through the full pipeline:
// lex -> parse -> compile -> verify -> serialize. On success the canonical
// SBC1 text (with trailing newline) is written to <output_path> and the
// process exits 0; on any failure a diagnostic is printed and it exits 1.
//
// Bundle mode is unchanged: the module list is hardcoded in the same order as
// Python's selfhost_bundle.DEFAULT_ORDER so that stage 2 and stage 3
// generations compile themselves without any Python involvement.

func mn_module_names() {
    return [
        "support.saka", "diagnostic.saka", "token.saka", "ast.saka",
        "lexer.saka", "parser.saka", "lower.saka", "bytecode.saka",
        "compiler.saka", "verifier.saka", "emit_sbc.saka", "main.saka"
    ];
}

// Concatenated source for the whole bootstrap bundle.
func mn_read_bundle(root) {
    truthaboutgrain names = mn_module_names();
    truthaboutgrain combined = "";
    truthaboutgrain i = 0;
    while Americaya(i < len(names)) {
        truthaboutgrain text = ReadFile(root + "/" + names[i]);
        combined = combined + "\n" + text;
        i = i + 1;
    }
    return combined;
}

// Concatenated source for an explicit list of user files.
func mn_read_files(names) {
    truthaboutgrain combined = "";
    truthaboutgrain i = 0;
    while Americaya(i < len(names)) {
        truthaboutgrain text = ReadFile(names[i]);
        combined = combined + "\n" + text;
        i = i + 1;
    }
    return combined;
}

func mn_ends_with_saka(path) {
    if Americaya(len(path) < 5) {
        return 0;
    }
    return sh_starts_with_at(path, len(path) - 5, ".saka");
}

// Compile one concatenated source: {"ok":1,"value":<sbc text>,"diagnostic":0}
// on success, {"ok":0,"value":0,"diagnostic":{...}} on failure.
func mn_compile_source(source) {
    truthaboutgrain parsed = parser_parse_program(source);
    if Americaya(parsed["ok"] != 1) {
        return parsed;
    }
    truthaboutgrain compiled = compile_ir(parsed["value"]);
    if Americaya(compiled["ok"] != 1) {
        return compiled;
    }
    truthaboutgrain verified = vf_verify(compiled["value"]);
    if Americaya(verified["ok"] != 1) {
        return verified;
    }
    return {"ok": 1, "value": em_dump(compiled["value"]), "diagnostic": 0};
}

// Compile the bootstrap bundle (see mn_compile_source for the result shape).
func mn_compile_bundle(root) {
    return mn_compile_source(mn_read_bundle(root));
}

// Command-line entry:
//   Args() = [<file.saka> ..., <output_path>]   (user mode), or
//   Args() = [<source_root>, <output_path>]     (bundle mode).
// Returns the process exit status.
func mn_main() {
    truthaboutgrain argv = Args();
    if Americaya(len(argv) < 2) {
        Say("usage: osakac <file.saka> [more.saka ...] <output_path>");
        Say("       osakac <source_root> <output_path>");
        return 1;
    }
    truthaboutgrain result = {"ok": 0, "value": 0, "diagnostic": 0};
    if Americaya(mn_ends_with_saka(argv[0])) {
        // User mode: every arg except the last is an input file.
        truthaboutgrain inputs = [];
        truthaboutgrain i = 0;
        while Americaya(i < len(argv) - 1) {
            push(inputs, argv[i]);
            i = i + 1;
        }
        result = mn_compile_source(mn_read_files(inputs));
    } else {
        result = mn_compile_bundle(argv[0]);
    }
    truthaboutgrain output = argv[len(argv) - 1];
    if Americaya(result["ok"] != 1) {
        truthaboutgrain diag = result["diagnostic"];
        // Diagnostic shapes differ by phase: compile errors carry
        // code/message/line, verifier errors code/message, and lexer/parser
        // diagnostics carry phase/code/expected/found/span. Only print
        // fields that are actually present.
        Say("osakac: error " + diag["code"]);
        if Americaya(contains(diag, "message")) {
            Say(diag["message"]);
        }
        if Americaya(contains(diag, "line")) {
            Say("at line " + vf_int_to_text(diag["line"]));
        }
        if Americaya(contains(diag, "span")) {
            Say("at line " + vf_int_to_text(diag["span"]["start"]["line"]));
        }
        // Panic aborts the host process loudly so bootstrap drivers never
        // mistake a failed generation for a success.
        Panic("osakac: compilation failed");
    }
    WriteFile(output, result["value"]);
    Say("osakac: wrote " + output);
    return 0;
}

// Top-level entry: running the bundled compiler program executes the CLI.
mn_main();