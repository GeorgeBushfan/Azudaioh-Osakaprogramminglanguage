// File I/O builtins MVP
// EXPECTED-DIAG: 0 warnings

truthaboutgrain p = "./tmp/io_mvp.txt";

DeleteFile(p);
WriteFile(p, "hello");
AppendFile(p, "|world");

truthaboutgrain exists1 = FileExists(p);
Say(exists1);

truthaboutgrain content = ReadFile(p);
Say(content);

DeleteFile(p);
truthaboutgrain exists2 = FileExists(p);
Say(exists2);
